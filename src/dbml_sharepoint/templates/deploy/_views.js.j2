        phase: '{{ phase.number }}', list: guarded.list, view: guarded.title, error: message,
      });
      return;
    }
    log('INFO', `[Phase {{ phase.number }}] Filter editor refuses '${guarded.title}', so declared`
      + ' filters cannot be truncated from view settings.');
  }
  await confirmEditorRefusesTheGuard();
